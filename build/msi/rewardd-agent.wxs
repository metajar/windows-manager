<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v4/v5 source for the rewardd Windows agent installer.

  Build it with build-msi.sh (which calls the `wix` dotnet tool). The MSI:
    * installs rewardd-agent.exe into "Program Files\rewardd"
    * registers the "brain" Windows service natively (ServiceInstall below), so
      Windows Installer stops the service BEFORE replacing files on upgrade and
      removes it cleanly on uninstall — no in-use-file reboots
    * writes the config file (ProgramData\rewardd\agent.conf) via
      `rewardd-agent.exe -writeconfig ...` before the service starts
    * on uninstall, runs `rewardd-agent.exe -uninstall-service` purely to remove
      the config file (the service itself is deleted by the MSI)

  Configuration is supplied at install time as MSI properties, e.g.:
    msiexec /i rewardd-agent.msi /qn ^
      SERVER="http://homelab:8080" TOKEN="xxxx" KIDUSER="leo" PIN="1234"
  The same properties must be passed again when upgrading: a major upgrade is a
  fresh install of the new product and the config file is rewritten.

  This installs the hardened brain/face split. The brain service holds the API
  token and the accounting and decides lock state; it cannot draw UI itself
  (session-0 services have no interactive desktop), so it launches a per-session
  "face" process (rewardd-agent.exe -face) into the logged-in user's desktop and
  relaunches it if it is killed. Killing the face therefore never buys free play.
  Stopping the brain terminates the face too, which is what releases the exe's
  file locks during an upgrade.

  MajorUpgrade is scheduled afterInstallExecute so the NEW package's
  StopServices/DeleteServices run before any files are copied; combined with the
  stable component GUID this lets upgrades replace the exe in place even when
  the previous version registered the service out-of-band (<= 0.0.2 used a
  custom action instead of ServiceInstall).

  The QuietExec deferred-custom-action pattern is the standard WiX idiom for
  running an installed exe as SYSTEM with property-derived arguments. The CA
  entry point WixQuietExec and the property WixQuietExecCmdLine are provided by
  the WixToolset.Util.wixext extension (added in build-msi.sh).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="rewardd agent"
           Manufacturer="rewardd"
           Version="$(var.Version)"
           UpgradeCode="6f3a1c2e-7b8d-4e1a-9c0f-2a4b6d8e0f11"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of the rewardd agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Install-time configuration. All are public (UPPERCASE) so they can be
         passed on the msiexec command line; sensible defaults where possible. -->
    <Property Id="SERVER" Secure="yes" />
    <Property Id="TOKEN" Secure="yes" />
    <Property Id="KIDUSER" Secure="yes" />
    <Property Id="MACHINE" Secure="yes" />
    <Property Id="PIN" Secure="yes" />
    <Property Id="INTERVAL" Secure="yes" Value="20" />
    <Property Id="GRACE" Secure="yes" Value="30" />

    <!-- Fail fast on a silent install if the essentials are missing. -->
    <Launch Condition="Installed OR (SERVER AND TOKEN AND KIDUSER)"
            Message="SERVER, TOKEN and KIDUSER are required. Example: msiexec /i rewardd-agent.msi SERVER=http://host:8080 TOKEN=... KIDUSER=leo" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="rewardd">
        <Component Id="AgentExeComponent" Guid="*">
          <File Id="AgentExe" Source="$(var.AgentExe)" KeyPath="yes" Name="rewardd-agent.exe" />

          <!-- Native service registration: MSI owns the service lifecycle, so
               StopServices/DeleteServices run before files change on
               install/upgrade/uninstall. Stop+Remove on install also absorbs a
               same-named service left behind by older CA-based installers. -->
          <ServiceInstall Id="BrainService"
                          Name="rewardd-agent-svc"
                          DisplayName="rewardd agent (brain)"
                          Description="Owns the rewardd time bank, decides screen lock state, and keeps the per-session lock UI alive."
                          Type="ownProcess"
                          Start="auto"
                          Account="LocalSystem"
                          ErrorControl="normal"
                          Arguments="-service -config &quot;[CommonAppDataFolder]rewardd\agent.conf&quot;" />
          <ServiceControl Id="BrainServiceControl"
                          Name="rewardd-agent-svc"
                          Stop="both" Remove="both" Start="install" Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="rewardd agent" Level="1">
      <ComponentRef Id="AgentExeComponent" />
    </Feature>

    <!-- ========================== WRITE CONFIG =========================== -->
    <!-- Materialize agent.conf from the MSI properties before the service is
         started. SetProperty Id == CA Id is the convention that wires the value
         through to the deferred action as CustomActionData. -->
    <SetProperty Id="RewarddWriteConfig" Sequence="execute" Before="RewarddWriteConfig"
                 Value="&quot;[#AgentExe]&quot; -writeconfig -config &quot;[CommonAppDataFolder]rewardd\agent.conf&quot; -server &quot;[SERVER]&quot; -token &quot;[TOKEN]&quot; -user &quot;[KIDUSER]&quot; -machine &quot;[MACHINE]&quot; -pin &quot;[PIN]&quot; -interval [INTERVAL] -grace [GRACE]" />

    <CustomAction Id="RewarddWriteConfig" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" />

    <!-- ============================ UNINSTALL ============================ -->
    <!-- The MSI deletes the service itself; this CA only removes the config
         file (which holds the API token). -->
    <SetProperty Id="RewarddUninstall" Sequence="execute" Before="RewarddUninstall"
                 Value="&quot;[#AgentExe]&quot; -uninstall-service -config &quot;[CommonAppDataFolder]rewardd\agent.conf&quot;" />

    <CustomAction Id="RewarddUninstall" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" />

    <InstallExecuteSequence>
      <!-- Config must exist before StartServices brings the brain up. -->
      <Custom Action="RewarddWriteConfig" Before="StartServices" Condition="NOT Installed" />
      <!-- Clean up the config before the exe is removed, only on real uninstall. -->
      <Custom Action="RewarddUninstall" Before="RemoveFiles" Condition="(REMOVE=&quot;ALL&quot;) AND (NOT UPGRADINGPRODUCTCODE)" />
    </InstallExecuteSequence>

  </Package>
</Wix>
