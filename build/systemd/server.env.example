# rewardd server configuration. Copy to /etc/rewardd/server.env and edit.
# This file is read by systemd (EnvironmentFile) and should be root-owned 0600
# because it contains the API token.

# REQUIRED: bearer token gating the whole API and dashboard.
# Generate one with:  openssl rand -hex 32
REWARDD_TOKEN=change-me-to-a-long-random-string

# PIN the lock screen accepts to buy more time (leave empty to disable /unlock).
REWARDD_PARENT_PIN=4242

# Listen address. Bind to localhost and front with a reverse proxy for TLS,
# or expose directly on your LAN with ":8080".
REWARDD_ADDR=:8080

# Persistence file. With the systemd unit this lives under StateDirectory.
REWARDD_DB=/var/lib/rewardd/rewardd.json

# Minutes granted per successful PIN unlock.
REWARDD_UNLOCK_MIN=30

# Heartbeat cadence (seconds) handed to agents; authoritative.
REWARDD_HEARTBEAT=20

# Anti-drain valve: max seconds a single heartbeat can charge.
REWARDD_MAXGAP=120

# Graceful shutdown drain timeout (seconds).
REWARDD_SHUTDOWN=10
